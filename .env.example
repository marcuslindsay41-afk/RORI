# Copy this file to .env and replace every value. All values below are fake examples.

# Application database (PostgreSQL). URL-encode special characters in the password.
DATABASE_URL=postgresql://example_user:example_password@localhost:5432/rori_db

# Local development database (used by docker-compose.yml)
POSTGRES_DB=rori_db
POSTGRES_USER=example_user
POSTGRES_PASSWORD=example_password

# Ingestion API keys: comma-separated "key:restaurant_id" pairs
RORI_API_KEYS=example-key-one:1,example-key-two:2

# JWT signing secret (use a long random string)
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Supabase (auth: users / restaurants tables)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=replace-with-your-supabase-key
